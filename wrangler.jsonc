{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Static ORBIT demo served as a Cloudflare Worker with static assets (no Worker script).
  "name": "orbit-envision",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Serve ONLY on the custom domain, which Cloudflare Access protects.
  // workers.dev and preview URLs stay off so there is no unprotected address.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // EDIT THIS ONE LINE: replace with your real hostname, for example orbit.ncscdude.com
    { "pattern": "orbit.YOUR-DOMAIN", "custom_domain": true }
  ]
}
